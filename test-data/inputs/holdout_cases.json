{
  "description": "HOLDOUT suite: written after the guard thresholds were tuned on test_cases.json and never used for tuning. Run it to see how the system generalises to new phrasings: python -m evaluation.runner --suite holdout",
  "cases": [
    {"id": "H01", "type": "Normal", "category": "Academic", "input": "If I get an F grade in a course, what are my options?",
     "expected_output": "Answered: re-register or take the supplementary exam; Academic Regulations 4.1",
     "expected_status": ["Answered"], "expected_sources": [{"category": "Academic Regulations", "section": "4.1"}],
     "require_all_sources": false, "must_include": [["re-register", "supplementary"]], "must_not_match": []},
    {"id": "H02", "type": "Normal", "category": "Hostel", "input": "Are electric kettles allowed in hostel rooms?",
     "expected_output": "Answered: not permitted; Hostel Policy 4.2",
     "expected_status": ["Answered"], "expected_sources": [{"category": "Hostel Policy", "section": "4.2"}],
     "require_all_sources": false, "must_include": [["not permitted", "not allowed"]], "must_not_match": []},
    {"id": "H03", "type": "Normal", "category": "Attendance", "input": "How long do I have to submit a medical certificate for attendance condonation?",
     "expected_output": "Answered: within 7 days of resuming classes; Attendance Policy 3.1",
     "expected_status": ["Answered"], "expected_sources": [{"category": "Attendance Policy", "section": "3.1"}],
     "require_all_sources": false, "must_include": [["7 days"]], "must_not_match": []},
    {"id": "H04", "type": "Edge", "category": "Fees", "input": "Can I get a refund if I withdraw after one month?",
     "expected_output": "Answered: no tuition refund after 15 days; Fee Regulations 3.1",
     "expected_status": ["Answered"], "expected_sources": [{"category": "Fee Regulations", "section": "3.1"}],
     "require_all_sources": false, "must_include": [["15 days"]], "must_not_match": []},
    {"id": "H05", "type": "Edge", "category": "Hinglish", "input": "hostel mein raat ko kitne baje tak aana hai?",
     "expected_output": "Answered: by 10:00 PM; Hostel Policy 2.1",
     "expected_status": ["Answered"], "expected_sources": [{"category": "Hostel Policy", "section": "2.1"}],
     "require_all_sources": false, "must_include": [["10:00 PM", "10 PM", "10:00 pm"]], "must_not_match": []},
    {"id": "H06", "type": "Edge", "category": "Ambiguous", "input": "What is the fee?",
     "expected_output": "Needs Clarification: which fee",
     "expected_status": ["Needs Clarification"], "expected_sources": [], "require_all_sources": false,
     "must_include": [], "must_not_match": []},
    {"id": "H07", "type": "Invalid", "category": "Out of scope", "input": "What is the WiFi password for the library?",
     "expected_output": "Not Covered",
     "expected_status": ["Not Covered"], "expected_sources": [], "require_all_sources": false,
     "must_include": [], "must_not_match": []},
    {"id": "H08", "type": "Edge", "category": "Not in knowledge base", "input": "Is there a dress code for students on campus?",
     "expected_output": "Not Covered: documents do not mention a dress code",
     "expected_status": ["Not Covered"], "expected_sources": [], "require_all_sources": false,
     "must_include": [], "must_not_match": []}
  ]
}
