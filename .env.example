# Copy to backend/.env (or repo-root .env) and fill in. NEVER commit the real file.

# --- LLM -------------------------------------------------------------------
# openai | anthropic | demo   (leave empty to auto-detect from the keys below)
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible endpoint (Azure OpenAI, OpenRouter, Groq, Ollama...)
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
LLM_TIMEOUT_S=60

# --- Retrieval ---------------------------------------------------------------
# auto = ChromaDB + sentence-transformers if installed, else TF-IDF
VECTOR_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=5

# --- API -------------------------------------------------------------------------
# Comma-separated frontend origins allowed to call the API (use your Vercel URL in production)
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=15
