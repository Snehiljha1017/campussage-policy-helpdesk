flowchart TD
  ROOT["CampusSage:<br/>answer policy questions only from official documents"]
  ROOT --> K["1. Build the knowledge base"]
  ROOT --> A["2. Answer a question"]
  ROOT --> E["3. Measure and improve prompts"]
  K --> K1["Upload PDF + category"]
